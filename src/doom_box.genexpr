// =====================================================================
//  THE DOOM BOX  —  component-level model of the schematic
//  Octave-up (Q3/Q4 splitter + D2/D3) > LM308 RAT stage > J201 buffer
//  > BS170 MOSFET boost.  8x oversampled, mono like the pedal
//  (L+R summed in, same signal out both sides).  1.0 = 1 volt.
// =====================================================================

// ---------- pot tapers ----------
taperA(t) {
    return (exp(4.394 * t) - 1) / (exp(4.394) - 1);
}

// smooth limiter used for transistor saturation / op-amp rails
sclip(v, L) {
    q = v / L;
    q2 = q * q;
    return v / sqrt(sqrt(1 + q2 * q2));
}

// tan() series, accurate to <0.1% for the arguments used inside the loop
ftan(x) {
    x2 = x * x;
    return x * (1 + x2 * (0.33333333 + x2 * (0.13333333 + x2 * 0.05396825)));
}

// J201 source follower, gate referenced to 0 V via 1M, Rs = 10k
// Idss 0.6 mA, Vp -0.8 V (square law). Returns source voltage.
jfet(vg) {
    k = 6.0;
    vp = -0.8;
    vs = 0;
    if (vg > vp) {
        w = (vp + sqrt(vp * vp - 4 * k * (vp - vg))) / (2 * k);
        vs = k * w * w;
    }
    return min(vs, 8.5);
}

// BS170 drain current, Rd 10k / Rs 470R, 9 V. Level-1 model, K 0.05, Vth 2.1
mosid(vg) {
    K = 0.05;
    RS = 470;
    RT = 10470;
    a = vg - 2.1;
    idr = 0;
    if (a > 0) {
        y = (sqrt(1 + 4 * RS * K * a) - 1) / (2 * RS * K);
        idr = K * y * y;
        vds = 9 - RT * idr;
        if (vds < y) {
            p0 = 9;
            p1 = -RT;
            q0 = 2 * a - 9;
            q1 = RT - 2 * RS;
            qa = K * p1 * q1;
            qb = K * (p0 * q1 + p1 * q0) - 1;
            qc = K * p0 * q0;
            dd = sqrt(max(qb * qb - 4 * qa * qc, 0));
            r1 = (-qb - dd) / (2 * qa);
            r2 = (-qb + dd) / (2 * qa);
            lim = 9 / RT;
            idr = lim;
            if (r2 >= 0 && r2 <= lim) { idr = r2; }
            if (r1 >= 0 && r1 <= lim) { idr = min(idr, r1); }
        }
    }
    return idr;
}

mosvd(vg) {
    return 9 - 10000 * mosid(vg);
}

// one-pole TPT coefficient
tptg(fc, sr) {
    return tan(pi * min(fc, 0.45 * sr) / sr);
}

// ---------- state ----------
Param pot_octave(0.5, min=0, max=1);     // OCTAVE 50KB
Param pot_dist(0.5, min=0, max=1); // DIST 100KA
Param pot_filter(0.3, min=0, max=1);     // FILTER 100KA
Param pot_amps(0.6, min=0, max=1);       // AMPS 100KA
Param pot_boost(0.5, min=0, max=1);      // BOOST 100KA
Param sw_clip(0, min=0, max=2);     // SW1: 0 = D4/D6 LED + D5, 1 = off, 2 = D7/D8
Param fs_dist(1, min=0, max=1);      // footswitch 1
Param fs_boost(0, min=0, max=1);     // footswitch 2

History sm_oct(0.5);
History sm_dist(0.5);
History sm_flt(0.3);
History sm_amps(0.6);
History sm_boost(0.5);
History sm_dm(1);
History sm_bm(0);
History last_rd(-1);
History fc_gbw(1000);
History ledpk(0);
History c2_L(0);
History c3_L(0);
History c10_L(0);
History c9_L(0);
History c7_L(0);
History c5_L(0);
History h1_L(0);
History h2_L(0);
History lf_L(0);
History gbw_L(0);
History yprev_L(0);
History flt_L(0);
History c19_L(0);
History c20_L(0);
History c22_L(0);
History vg_L(2.3901877);
History c23_L(4.7803755);
History up0a_L(0);
History up0b_L(0);
History up1a_L(0);
History up1b_L(0);
History up2a_L(0);
History up2b_L(0);
History up3a_L(0);
History up3b_L(0);
History up4a_L(0);
History up4b_L(0);
History dn0a_L(0);
History dn0b_L(0);
History dn1a_L(0);
History dn1b_L(0);
History dn2a_L(0);
History dn2b_L(0);
History dn3a_L(0);
History dn3b_L(0);
History dn4a_L(0);
History dn4b_L(0);
OSF = 8;

// ---------- per-sample control (base rate) ----------
VS0 = 0.5563859006490657;
VG0 = 2.3901877380900185;
sr4 = samplerate * OSF;
sk = 1 - exp(-1 / (0.02 * samplerate));
fk = 1 - exp(-1 / (0.004 * samplerate));
p_oct = sm_oct + (pot_octave - sm_oct) * sk;
p_dist = sm_dist + (pot_dist - sm_dist) * sk;
p_flt = sm_flt + (pot_filter - sm_flt) * sk;
p_amps = sm_amps + (pot_amps - sm_amps) * sk;
p_boost = sm_boost + (pot_boost - sm_boost) * sk;
dm = sm_dm + ((fs_dist > 0.5) - sm_dm) * fk;
bm = sm_bm + ((fs_boost > 0.5) - sm_bm) * fk;
sm_oct = p_oct;
sm_dist = p_dist;
sm_flt = p_flt;
sm_amps = p_amps;
sm_boost = p_boost;
sm_dm = dm;
sm_bm = bm;

rd = 100000 * taperA(p_dist) + 1;
rf = 100000 * taperA(p_flt);
a_amps = taperA(p_amps);
a_boost = taperA(p_boost);
cmode = floor(clamp(sw_clip, 0, 2) + 0.5);

// closed-loop bandwidth of the LM308 (GBW 1 MHz with 30p) for this DIST setting
fg = fc_gbw;
lrd = last_rd;
f = 0;
j = 0;
w = 0; zd = 0; zr = 0; zi = 0; t1 = 0; t2 = 0; yr = 0; yim = 0; gr = 0; gi = 0;
if (abs(rd - lrd) > 0.5) {
    f = max(fg, 10);
    for (j = 0; j < 24; j += 1) {
        w = twopi * f;
        zd = 1 + (w * rd * 0.0000000001) * (w * rd * 0.0000000001);
        zr = rd / zd;
        zi = -w * rd * rd * 0.0000000001 / zd;
        t1 = w * 560 * 0.0000047;
        t2 = w * 47 * 0.0000022;
        yr = (w * 0.0000047 * t1) / (1 + t1 * t1) + (w * 0.0000022 * t2) / (1 + t2 * t2);
        yim = (w * 0.0000047) / (1 + t1 * t1) + (w * 0.0000022) / (1 + t2 * t2);
        gr = 1 + zr * yr - zi * yim;
        gi = zr * yim + zi * yr;
        f = sqrt(f * 1000000 / sqrt(gr * gr + gi * gi));
    }
    fg = f;
    lrd = rd;
}
last_rd = lrd;
fc_gbw = fg;

g_c2 = tptg(1.5915, sr4);
g_c3 = tptg(3.1831, sr4);
g_c10 = tptg(37.273, sr4);
g_c9 = tptg(15.915, sr4);
g_c7 = tptg(3.1831, sr4);
g_c5 = tptg(7.2343, sr4);
g_h1 = tptg(60.469, sr4);
g_h2 = tptg(1539.2, sr4);
g_lf = tptg(1 / (twopi * rd * 0.0000000001), sr4);
g_gbw = tptg(fg, sr4);
g_c19 = tptg(7.2343, sr4);
g_c20 = tptg(1.5915, sr4);
g_c22 = tptg(6.0, sr4);
g_c23 = tptg(0.15915, sr4);
slew = 300000 / sr4;

// SW1 diode sets: (Is, n*Vt) for + and - current directions
isp = 0.00000000252;
vtp = 0.0452892;
isn = 0.00000000252;
vtn = 0.0452892;
if (cmode == 0) {
    isn = 0.00000000000007286786306625592;
    vtn = 0.0969892;
}
ledi = 0;

// temporaries
bin = 0;
bl = 0;
bo = 0;
bq = 0;
bu = 0;
by = 0;
clean = 0;
dab = 0;
dfd = 0;
dout = 0;
e1 = 0;
e2 = 0;
ea = 0;
eb = 0;
f0 = 0;
f1 = 0;
fo = 0;
gd = 0;
gfl = 0;
hp1 = 0;
hp2 = 0;
idd = 0;
inner = 0;
lfo = 0;
oL = 0;
oct = 0;
q1 = 0;
q5 = 0;
q5g = 0;
rect = 0;
rsrc = 0;
rtot = 0;
sh = 0;
sv = 0;
tl = 0;
tv = 0;
ug = 0;
ux = 0;
vd = 0;
vdr = 0;
vg = 0;
vp = 0;
x = 0;
xb = 0;
xg = 0;
xin_L = 0;
xu = 0;
yg = 0;
yi = 0;
yo_L = 0;
yop = 0;
yy = 0;
i = 0;
k = 0;
    // ================= channel L =================
    lc2_L = c2_L;
    lc3_L = c3_L;
    lc10_L = c10_L;
    lc9_L = c9_L;
    lc7_L = c7_L;
    lc5_L = c5_L;
    lh1_L = h1_L;
    lh2_L = h2_L;
    llf_L = lf_L;
    lgbw_L = gbw_L;
    lyprev_L = yprev_L;
    lflt_L = flt_L;
    lc19_L = c19_L;
    lc20_L = c20_L;
    lc22_L = c22_L;
    lvg_L = vg_L;
    lc23_L = c23_L;
    lup0a_L = up0a_L;
    lup0b_L = up0b_L;
    lup1a_L = up1a_L;
    lup1b_L = up1b_L;
    lup2a_L = up2a_L;
    lup2b_L = up2b_L;
    lup3a_L = up3a_L;
    lup3b_L = up3b_L;
    lup4a_L = up4a_L;
    lup4b_L = up4b_L;
    ldn0a_L = dn0a_L;
    ldn0b_L = dn0b_L;
    ldn1a_L = dn1a_L;
    ldn1b_L = dn1b_L;
    ldn2a_L = dn2a_L;
    ldn2b_L = dn2b_L;
    ldn3a_L = dn3a_L;
    ldn3b_L = dn3b_L;
    ldn4a_L = dn4a_L;
    ldn4b_L = dn4b_L;
    xin_L = 0.5 * (in1 + in2);
    yo_L = 0;
    for (i = 0; i < 8; i += 1) {
        xu = (i == 0) ? 8 * xin_L : 0;
        bq = xu;
        by = 0.00002664419485875052 * bq + lup0a_L;
        lup0a_L = 0.000013513453355839464 * bq - (-1.7583324601554213) * by + lup0b_L;
        lup0b_L = 0.000026644194858750532 * bq - (0.7771552285440217) * by;
        bq = by;
        by = 1.0 * bq + lup1a_L;
        lup1a_L = -1.293652348533099 * bq - (-1.7743486493083187) * by + lup1b_L;
        lup1b_L = 1.0000000000000002 * bq - (0.8201139220784449) * by;
        bq = by;
        by = 1.0 * bq + lup2a_L;
        lup2a_L = -1.6401055496190053 * bq - (-1.798204594973908) * by + lup2b_L;
        lup2b_L = 1.0000000000000002 * bq - (0.8801531038102874) * by;
        bq = by;
        by = 1.0 * bq + lup3a_L;
        lup3a_L = -1.741143170421827 * bq - (-1.8237861063252796) * by + lup3b_L;
        lup3b_L = 0.9999999999999999 * bq - (0.9349692822084059) * by;
        bq = by;
        by = 1.0 * bq + lup4a_L;
        lup4a_L = -1.7738559232615518 * bq - (-1.8522358298743857) * by + lup4b_L;
        lup4b_L = 0.9999999999999998 * bq - (0.9796234607507663) * by;
        bq = by;
        x = bq;

        // ---- Q1 J201 input buffer (C2/R3 coupling, gate at 0 V) ----
        tv = (x - lc2_L) * (g_c2 / (1 + g_c2));
        tl = tv + lc2_L;
        lc2_L = tl + tv;
        xg = x - tl;
        q1 = jfet(xg) - VS0;

        // clean leg: C3 into OCTAVE pot
        tv = (q1 - lc3_L) * (g_c3 / (1 + g_c3));
        tl = tv + lc3_L;
        lc3_L = tl + tv;
        clean = q1 - tl;

        // ---- octave leg: C10 > Q4 (gain -R16/(R17+re)) > Q3 splitter ----
        tv = (q1 - lc10_L) * (g_c10 / (1 + g_c10));
        tl = tv + lc10_L;
        lc10_L = tl + tv;
        xb = q1 - tl;
        sv = -8.67 * xb;
        sv = (sv > 0) ? sclip(sv, 1.05) : sclip(sv, 6.9);
        // C9 / C8 into 100k, emitter (+0.96) and collector (-0.95) outputs
        tv = (sv - lc9_L) * (g_c9 / (1 + g_c9));
        tl = tv + lc9_L;
        lc9_L = tl + tv;
        sh = sv - tl;
        ea = 0.96 * sh;
        eb = -0.95 * sh;
        // D3 / D2 diode-OR (full wave) into Q2 follower
        dab = abs(ea - eb);
        rect = max(ea, eb) - 0.031399;
        if (dab < 0.5) { rect = rect + 0.0453 * log(1 + exp(-dab / 0.0453)); }
        rect = sclip(rect, 5.0);
        tv = (rect - lc7_L) * (g_c7 / (1 + g_c7));
        tl = tv + lc7_L;
        lc7_L = tl + tv;
        oct = rect - tl;

        // OCTAVE 50KB blend (wiper between C3 and C7)
        bl = clean + (oct - clean) * p_oct;

        // ---- LM308 non-inverting stage ----
        tv = (bl - lc5_L) * (g_c5 / (1 + g_c5));
        tl = tv + lc5_L;
        lc5_L = tl + tv;
        vp = bl - tl;
        tv = (vp - lh1_L) * (g_h1 / (1 + g_h1));
        tl = tv + lh1_L;
        lh1_L = tl + tv;
        hp1 = vp - tl;
        tv = (vp - lh2_L) * (g_h2 / (1 + g_h2));
        tl = tv + lh2_L;
        lh2_L = tl + tv;
        hp2 = vp - tl;
        inner = rd / 560 * hp1 + rd / 47 * hp2;
        tv = (inner - llf_L) * (g_lf / (1 + g_lf));
        tl = tv + llf_L;
        llf_L = tl + tv;
        lfo = tl;
        yi = vp + lfo;
        // finite gain-bandwidth (30p compensation)
        tv = (yi - lgbw_L) * (g_gbw / (1 + g_gbw));
        tl = tv + lgbw_L;
        lgbw_L = tl + tv;
        yg = tl;
        yg = sclip(yg, 3.5);
        // slew rate 0.3 V/us
        yop = lyprev_L + clamp(yg - lyprev_L, -slew, slew);
        lyprev_L = yop;

        // ---- R23 1k into SW1 diode network ----
        vd = yop;
        gd = 0;
        if (cmode != 1) {
            ux = yop;
            vd = 0;
            if (ux > 0) { vd = min(ux, vtp * log(ux / (1000 * isp) + 1)); }
            if (ux < 0) { vd = max(ux, -vtn * log(-ux / (1000 * isn) + 1)); }
            for (k = 0; k < 5; k += 1) {
                if (vd >= 0) {
                    e1 = exp(vd / vtp);
                    idd = isp * (e1 - 1);
                    gd = isp / vtp * e1;
                } else {
                    e1 = exp(-vd / vtn);
                    idd = -isn * (e1 - 1);
                    gd = isn / vtn * e1;
                }
                vd = vd - (vd + 1000 * idd - ux) / (1 + 1000 * gd);
            }
            e2 = 1;
            if (vd >= 0) {
                gd = isp / vtp * exp(vd / vtp);
            } else {
                e2 = exp(-vd / vtn);
                gd = isn / vtn * e2;
            }
            if (cmode == 0) { ledi = max(ledi, isn * (e2 - 1)); }
        }

        // ---- FILTER: (R_src + FILTER + R24 1k5) into C18 3n3 ----
        rtot = 1000 / (1 + 1000 * gd) + rf + 1500;
        gfl = ftan(pi / (twopi * rtot * 0.0000000033 * sr4));
        tv = (vd - lflt_L) * (gfl / (1 + gfl));
        tl = tv + lflt_L;
        lflt_L = tl + tv;
        fo = tl;

        // ---- C19 > Q5 J201 output buffer > C20 > AMPS ----
        tv = (fo - lc19_L) * (g_c19 / (1 + g_c19));
        tl = tv + lc19_L;
        lc19_L = tl + tv;
        q5g = fo - tl;
        q5 = jfet(q5g) - VS0;
        tv = (q5 - lc20_L) * (g_c20 / (1 + g_c20));
        tl = tv + lc20_L;
        lc20_L = tl + tv;
        dout = q5 - tl;
        dout = dout * a_amps;

        // footswitch 1 (true bypass)
        bin = x + (dout - x) * dm;

        // ---- BS170 boost: R28 1k + C22 1u, R29 470k drain->gate, R30 470k ----
        rsrc = 1000 + dm * 100000 * a_amps * (1 - a_amps);
        tv = (bin - lc22_L) * (g_c22 / (1 + g_c22));
        tl = tv + lc22_L;
        lc22_L = tl + tv;
        bu = bin - tl;
        bo = 0;
        if (bm > 0.00001) {
            ug = VG0 + bu;
            vg = lvg_L;
            for (k = 0; k < 3; k += 1) {
                f0 = (ug - vg) / rsrc + (mosvd(vg) - vg) / 470000 - vg / 470000;
                f1 = (ug - vg - 0.0001) / rsrc + (mosvd(vg + 0.0001) - vg - 0.0001) / 470000 - (vg + 0.0001) / 470000;
                dfd = (f1 - f0) / 0.0001;
                vg = clamp(vg - f0 / dfd, -9, 18);
            }
            lvg_L = vg;
            vdr = mosvd(vg);
        tv = (vdr - lc23_L) * (g_c23 / (1 + g_c23));
        tl = tv + lc23_L;
        lc23_L = tl + tv;
        bo = vdr - tl;
        }
        bo = bo * a_boost;

        // footswitch 2
        yy = bin + (bo - bin) * bm;

        bq = yy;
        by = 0.00002664419485875052 * bq + ldn0a_L;
        ldn0a_L = 0.000013513453355839464 * bq - (-1.7583324601554213) * by + ldn0b_L;
        ldn0b_L = 0.000026644194858750532 * bq - (0.7771552285440217) * by;
        bq = by;
        by = 1.0 * bq + ldn1a_L;
        ldn1a_L = -1.293652348533099 * bq - (-1.7743486493083187) * by + ldn1b_L;
        ldn1b_L = 1.0000000000000002 * bq - (0.8201139220784449) * by;
        bq = by;
        by = 1.0 * bq + ldn2a_L;
        ldn2a_L = -1.6401055496190053 * bq - (-1.798204594973908) * by + ldn2b_L;
        ldn2b_L = 1.0000000000000002 * bq - (0.8801531038102874) * by;
        bq = by;
        by = 1.0 * bq + ldn3a_L;
        ldn3a_L = -1.741143170421827 * bq - (-1.8237861063252796) * by + ldn3b_L;
        ldn3b_L = 0.9999999999999999 * bq - (0.9349692822084059) * by;
        bq = by;
        by = 1.0 * bq + ldn4a_L;
        ldn4a_L = -1.7738559232615518 * bq - (-1.8522358298743857) * by + ldn4b_L;
        ldn4b_L = 0.9999999999999998 * bq - (0.9796234607507663) * by;
        bq = by;
        yo_L = bq;
    }
    c2_L = lc2_L;
    c3_L = lc3_L;
    c10_L = lc10_L;
    c9_L = lc9_L;
    c7_L = lc7_L;
    c5_L = lc5_L;
    h1_L = lh1_L;
    h2_L = lh2_L;
    lf_L = llf_L;
    gbw_L = lgbw_L;
    yprev_L = lyprev_L;
    flt_L = lflt_L;
    c19_L = lc19_L;
    c20_L = lc20_L;
    c22_L = lc22_L;
    vg_L = lvg_L;
    c23_L = lc23_L;
    up0a_L = lup0a_L;
    up0b_L = lup0b_L;
    up1a_L = lup1a_L;
    up1b_L = lup1b_L;
    up2a_L = lup2a_L;
    up2b_L = lup2b_L;
    up3a_L = lup3a_L;
    up3b_L = lup3b_L;
    up4a_L = lup4a_L;
    up4b_L = lup4b_L;
    dn0a_L = ldn0a_L;
    dn0b_L = ldn0b_L;
    dn1a_L = ldn1a_L;
    dn1b_L = ldn1b_L;
    dn2a_L = ldn2a_L;
    dn2b_L = ldn2b_L;
    dn3a_L = ldn3a_L;
    dn3b_L = ldn3b_L;
    dn4a_L = ldn4a_L;
    dn4b_L = ldn4b_L;
    oL = yo_L;

// D6 glow (peak hold with ~60 ms release)
lb = clamp(ledi / 0.002, 0, 1);
lp = max(lb, ledpk * exp(-1 / (0.06 * samplerate)));
ledpk = lp;

out1 = oL;
out2 = oL;
out3 = lp * dm;
